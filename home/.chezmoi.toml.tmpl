{{- $gituser := promptString "gituser name" "hushin" -}}
{{- $email := promptString "email" "ngtv.hsn@gmail.com" -}}
{{- $personal := true -}}

{{- if ne $gituser "hushin" -}}
{{-   $personal = false -}}
{{- end -}}

{{- if $personal }}
# 個人用ファイル(encrypted_*)の暗号化。秘密鍵は 1Password の Personal/chezmoi-age-key にあり、
# run_onchange_before_00_age-key.sh が ~/.config/chezmoi/key.txt に取り出す。
encryption = "age"
[age]
  identity = {{ joinPath .chezmoi.homeDir ".config/chezmoi/key.txt" | quote }}
  recipient = "age1w9krd8kjn6spxhgzz0sgd8wtfp7khaxm3ncrsudcshf3x42whaps0l4e7x"
{{- end }}

[data]
  command = "code"
  args = ["--wait"]
  gituser = {{ $gituser | quote }}
  email = {{ $email | quote }}
  personal = {{ $personal }}
