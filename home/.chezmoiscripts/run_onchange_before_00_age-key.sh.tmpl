{{- if and .personal (ne .chezmoi.os "windows") -}}
#!/bin/sh
# chezmoi の age 秘密鍵を 1Password(Personal/chezmoi-age-key)から ~/.config/chezmoi/key.txt に取り出す。
# すでにあれば何もしない。暗号化ファイル(encrypted_*)は鍵がないと .chezmoiignore で除外されるので、
# 新しいマシンでは、この取り出しのあとにもう一度 chezmoi apply する。
set -eu
key="$HOME/.config/chezmoi/key.txt"
[ -f "$key" ] && exit 0
if ! command -v op >/dev/null 2>&1; then
  echo "op が無いため age 鍵を取り出せません。暗号化ファイルは配置されません" >&2
  exit 0
fi
mkdir -p "$(dirname "$key")"
umask 077
if op read --no-newline "op://Personal/chezmoi-age-key/password" >"$key.tmp"; then
  echo >>"$key.tmp"
  mv "$key.tmp" "$key"
  echo "age 鍵を配置しました。暗号化ファイルを入れるため、もう一度 chezmoi apply してください" >&2
else
  rm -f "$key.tmp"
  echo "1Password から age 鍵を取り出せませんでした。暗号化ファイルは配置されません" >&2
fi
{{- end }}
