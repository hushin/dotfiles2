{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/ghq/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.nuget/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.dotnet/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
  ],
  "agents": {
    "general": {
      "model": "opencode/deepseek-v4.1-flash-free",
    },
    "explore": {
      "model": "opencode/deepseek-v4.1-flash-free",
    },
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"],
      },
    },
  },
}
