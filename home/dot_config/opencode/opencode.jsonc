{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "opencode-go/deepseek-v4.1-flash",
  "permission": {
    "external_directory": {
      "~/ghq/**": "allow",
      "/tmp/**": "allow",
    },
  },
  "agent": {
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
    },
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true,
    },
  },
}
