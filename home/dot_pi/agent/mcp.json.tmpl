{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "browse": {
      "command": "~/.local/bin/browse{{ if eq .chezmoi.os `windows` }}.exe{{ end }}",
      "args": [
        "mcp"
      ],
      "description": "Control the user's real browser (tabs, logins, extensions) via the browse Chrome extension: open/drive tabs with Playwright, screenshots, recording, HAR"
    }
  }
}
